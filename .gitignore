# ──────────────────────────────────────────────────
# RecipeVault — Root .gitignore
# ──────────────────────────────────────────────────

# Dependency directories
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Build outputs
dist/
build/
.next/
out/

# Vite cache
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Editor directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
